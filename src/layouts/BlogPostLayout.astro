---
import BaseLayout from './BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import UnavailableNotice from '../components/UnavailableNotice.astro';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'blog'>;
  lang?: Lang;
  unavailable?: boolean;
  bareSlug?: string;
}

const { entry, lang = 'pt', unavailable = false, bareSlug = '' } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, tags, kind, readTime } = entry.data;

const dateLocale = lang === 'pt' ? 'pt-BR' : 'en-CA';
const formatted = pubDate.toLocaleDateString(dateLocale);

const altLang: Lang = lang === 'pt' ? 'en' : 'pt';
const altSlugPath = `/${altLang}/blog/${bareSlug}`;
---

<BaseLayout
  title={`${title} — R. F. Costa`}
  description={description}
  lang={lang}
  canonicalSlug={`/blog/${bareSlug}`}
>
  <div class="page">
    <div class="container">

      <Masthead
        left={t('nav.back_blog')}
        leftHref={`/${lang}/blog`}
        center={title}
        right=""
        lang={lang}
      />

      <article>
        {unavailable && (
          <UnavailableNotice
            message={t('notice.unavailable')}
            switchLabel={t('notice.switch')}
            switchHref={altSlugPath}
          />
        )}

        <header class="post-header">
          <div class="meta">
            <span class="post-date">{formatted}</span>
            {readTime && <span class="post-read">{readTime} {t('blog.min_read')} read</span>}
            <span class="post-kind">{kind}</span>
          </div>
          <h1 class="post-title">{title}</h1>
          {tags.length > 0 && (
            <div class="tags">
              {tags.map(tag => <span class="tag">#{tag}</span>)}
            </div>
          )}
        </header>

        <div class="prose">
          <slot />
        </div>
      </article>

      <Footer lang={lang} />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: 80px 0;
    min-height: 100vh;
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 40px;
    background: var(--bg);
  }

  .post-header { margin-bottom: 40px; }

  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 18px;
    letter-spacing: 0.05em;
  }

  .post-kind {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 10px;
  }

  .post-title {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: var(--ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .prose {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }

  .prose :global(p) { margin: 0 0 1.1em; text-align: justify; }
  .prose :global(h2) {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 26px;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
    margin: 1.8em 0 0.6em;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 6px;
  }
  .prose :global(h3) {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 20px;
    font-weight: 400;
    font-style: italic;
    margin: 1.4em 0 0.5em;
  }
  .prose :global(a) { color: var(--accent); text-decoration-style: dotted; text-underline-offset: 4px; }
  .prose :global(code) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875em;
    background: var(--paper);
    padding: 1px 5px;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .prose :global(pre) {
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 16px 18px;
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.5;
    border-radius: 2px;
    margin: 1.4em 0;
  }
  .prose :global(pre code) { background: none; border: none; padding: 0; }
  .prose :global(blockquote) {
    border-left: 2px solid var(--rule);
    margin: 1.4em 0;
    padding: 4px 0 4px 18px;
    color: var(--muted);
    font-style: italic;
  }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin: 0 0 1.1em; }
  .prose :global(li) { margin-bottom: 4px; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--rule); margin: 2em 0; }
</style>
