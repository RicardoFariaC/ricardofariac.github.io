---
// Root: redirect to /pt/ or /en/ based on browser language preference.
// Falls back to /pt/ (primary audience).
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var lang = (navigator.language || navigator.languages[0] || 'pt').toLowerCase();
        var dest = lang.startsWith('en') ? '/en/' : '/pt/';
        window.location.replace(dest);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/pt/" />
    </noscript>
  </head>
  <body></body>
</html>
