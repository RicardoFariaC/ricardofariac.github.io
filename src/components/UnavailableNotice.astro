---
interface Props {
  message: string;
  switchLabel: string;
  switchHref: string;
}
const { message, switchLabel, switchHref } = Astro.props;
---

<div class="unavailable-notice">
  <span class="notice-icon">⚠</span>
  <span class="notice-text">{message}</span>
  <a href={switchHref} class="notice-link">{switchLabel} →</a>
</div>

<style>
  .unavailable-notice {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--accent);
    border-left-width: 3px;
    margin-bottom: 36px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .notice-icon { color: var(--accent); flex-shrink: 0; }

  .notice-link {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
    white-space: nowrap;
  }
  .notice-link:hover { opacity: 0.8; }
</style>
