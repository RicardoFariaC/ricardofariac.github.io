---
import { Image } from 'astro:assets';
import HeaderButton from './Header/HeaderButton.astro';
import githubSvg from "../../public/icons/github.svg";
---

<header class="select-none flex justify-around items-center p-2 border-b border-gray-400">
	<p class="font-semibold text-2xl hidden md:inline">Ricardo Faria</p>
	<div class="flex items-center gap-5">
		<HeaderButton class="rounded-xl" href="/blog" content="Blog" />
		<HeaderButton class="rounded-xl" href="/" content="Sobre" />
		<div class="flex gap-2">
			<HeaderButton href="https://github.com/RicardoFariaC" class="rounded-full w-10 h-10 flex items-center">
				<img src="/icons/github.svg"  alt="" srcset="">
			</HeaderButton>
			<HeaderButton href="https://www.linkedin.com/in/ricardofariac/" class="rounded-full w-10 h-10 flex items-center">
				<img src="/icons/linkedin.svg" alt="" srcset="">
			</HeaderButton>
		</div>
	</div>
</header>